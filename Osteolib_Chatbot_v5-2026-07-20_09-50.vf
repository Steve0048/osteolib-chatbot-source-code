                {
                  "variableID": "6a5aa485e77e91eef4559ffe"
                },
                {
                  "text": [
                    " ! Je suis Oli, l'assistant d'Osteolib. Comment s'appelle votre compagnon à 4 pattes ?"
                  ],
                  "attributes": {
                    "color": {
                      "a": 1,
                      "b": 255,
                      "g": 125,
                      "r": 57
                    },
                    "__type": "text"
                  }
                }
              ],
