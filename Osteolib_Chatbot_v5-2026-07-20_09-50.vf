              }
            ]
          }
        },
        "6a5bdb999d9563ddeabeedf2": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "Ces symptômes nécessitent un examen vétérinaire préalable. L'ostéopathie ne peut pas se substituer à un diagnostic médical. Merci de consulter votre vétérinaire avant de prendre rendez-vous."
                        }
                      ]
                    }
                  ],
                  "delay": null
                }
              }
            ]
          }
        },
        "6a5bdbbe9d9563ddeabeedfc": {
