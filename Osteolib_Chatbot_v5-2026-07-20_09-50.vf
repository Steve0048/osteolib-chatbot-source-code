  "functions": [
    {
      "id": "6a5c090c9d9563ddeabeeef5",
      "name": "ext_file_upload",
      "createdByID": 2074143,
      "folderID": null,
      "code": "export default async function main(args) {\n  return {\n    trace: [\n      {\n        type: 'ext_file_upload',\n        payload: {\n          label: 'Ajoutez votre fichier',\n        },\n      },\n    ],\n    next: {\n      listen: true,\n      to: [\n        {\n          on: { 'event.type': 'complete' },\n          dest: 'complete',\n        },\n      ],\n      defaultTo: 'complete',\n    },\n  };\n}",
      "image": null,
      "description": null,
      "pathOrder": [
        "6a5c0f489d9563ddeabeefc2"
      ],
      "settings": null,
      "createdAt": "2026-07-20T08:24:19.000Z",
      "updatedAt": "2026-07-20T08:24:19.000Z",
      "updatedByID": 2074143
    },
    {
      "id": "6a5ced9a4dd6ea9f1332b660",
      "name": "readData",
      "createdByID": 2074143,
      "folderID": null,
      "code": "export default async function main(args) {\n  const event = args.inputVars.last_event;\n\n  return {\n    outputVars: {\n      fileUrl: event.payload.file,\n      skipped: event.payload.skipped,\n      fileName: event.payload.fileName,\n    },\n  };\n}",
      "image": null,
      "description": null,
      "pathOrder": [],
      "settings": null,
      "createdAt": "2026-07-20T08:24:19.000Z",
      "updatedAt": "2026-07-20T08:24:19.000Z",
      "updatedByID": 2074143
    }
  ],
