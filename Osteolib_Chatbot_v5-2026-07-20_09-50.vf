        "6a5bd8d79d9563ddeabeed90": {
          "variants": {
            "default:en-us": [
              {
                "condition": null,
                "data": {
                  "text": [
                    {
                      "children": [
                        {
                          "text": "Quel est le motif principal de la consultation ?"
                        }
                      ]
                    }
